                    <xs:documentation>A Composite containing details of the Identifier for the Party. If no namespace is given, the Identifier is a DdexPartyId (PID). Note that PIDs are usually not used to identify Artists, Producers or Creators.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:sequence>
                <xs:element name="PartyName" type="ddexC:PartyName">
                    <xs:annotation>
                        <xs:documentation>A Composite containing details of the Names for the Party.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="PartyId" type="ddexC:PartyId" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>A Composite containing details of the Identifier for the Party. If no namespace is given, the Identifier is a DdexPartyId (PID). Note that PIDs are usually not used to identify Artists, Producers or Creators.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:choice>
    </xs:complexType>
    <xs:complexType name="PartyId">
        <xs:annotation>
            <xs:documentation>A Composite containing details of an Identifier of a Party. If no namespace is given, the Identifier is a DdexPartyId (PID). Note that PIDs are usually not used to identify Artists, Producers or Creators.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="Namespace" type="xs:string" use="optional">
