            <xs:element name="CueSheetList" minOccurs="0" type="ddexC:CueSheetList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A ddex:Composite containing details of
                     one or more ddex:CueSheets contained in ddex:Releases for which sales data is
                     provided in the ddex:Message.</xs:documentation>
