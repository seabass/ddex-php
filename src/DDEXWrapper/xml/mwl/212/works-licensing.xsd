            </xs:annotation>
         </xs:element>
         <xs:element name="GlobalOriginalReleaseDate" minOccurs="0" type="ddexC:EventDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A ddex:Composite containing details of the
                  Date of the ddex:Event in which the collection of tracks for the ddex:Release
