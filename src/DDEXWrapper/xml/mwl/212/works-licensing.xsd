            </xs:annotation>
         </xs:element>
         <xs:element name="ReferenceTitle" type="ddexC:ReferenceTitle">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A ddex:Composite containing details of the
                  ddex:ReferenceTitle of the ddexC:SheetMusic.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="CreationDate" minOccurs="0" type="ddexC:EventDate">
