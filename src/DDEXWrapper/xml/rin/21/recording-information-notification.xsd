               <xs:documentation source="ddex:Definition">A Composite containing the Name to be used by a DSP when presenting Artist details of the RecordingComponent to a Consumer.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/communicating-displayartists-and-displayartistname</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/displayartistnames-for-releases-and-resources</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/information-on-displayartists%2C-displayartistnames%2C-contributors-and-indirectcontributors</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Comment" minOccurs="0" type="rin:Comment">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing a human-readable Comment about the RecordingComponent.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Contributor"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:RecordingComponentContributorReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing a RecordingComponentContributorReference.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="RecordingComponentEquipmentReference"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:EquipmentReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for Equipment used for the RecordingComponent (specific to this Message). This is a LocalEquipmentAnchorReference starting with the letter I.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="RecordingComponentFileReference" minOccurs="0">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a File (specific to this Message). This is a LocalFileAnchorReference starting with the letter F.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="F[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="CreationDate" minOccurs="0" type="rin:EventDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the Date at which the RecordingComponent was created. This is a string with the syntax YYYY[-MM[-DD]].</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="LanguageOfPerformance"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="avs:IsoLanguageCode">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Language of the Performance recorded in the RecordingComponent (represented by an ISO 639 LanguageCode).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="IsMedley" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Flag indicating whether the RecordingComponent is a Medley (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="RecordingComponentContributorReference">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing a RecordingComponentContributorReference.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="RecordingComponentContributorReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a Contributor (specific to this Message). This is a LocalPartyAnchorReference starting with the letter P.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="P[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="Role"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:ContributorRole">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a role played by the Contributor in relation to the Resource.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="InstrumentType"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:InstrumentType">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of an Instrument played by the Contributor in relation to the Resource.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ContributorEquipmentReference"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:EquipmentReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for Equipment used by the Contributor (specific to this Message). This is predominantly for musical Instruments. This is a LocalEquipmentAnchorReference starting with the letter I.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DisplayCredits"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:DisplayCredits">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Role and instrumentation for which a Party is credited.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="HasMadeFeaturedContribution" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Contributor is a featured Artist (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="HasMadeContractedContribution"
                     minOccurs="0"
                     type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Contributor is an Artist that has a contract for its part in creating the Resource (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="IsCreditedArtist" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Contributor is an Artist that  is meant to be credited for his or her Performance (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="RightSharePercentage" minOccurs="0" type="xs:decimal">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">Percentage of the MusicalWork that is being recorded in the Resource described by the parent composite that is owned by the Contributor. A quarter share is represented by '25' (and not 0.25).</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/general-guidance-on-messages/communication-of-percentages</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
      <xs:attribute name="SequenceNumber" type="xs:integer">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The number indicating the order of the Contributor in a group of Contributors that have contributed to a SoundRecording. This is represented in an XML schema as an XML Attribute. </xs:documentation>
         </xs:annotation>
      </xs:attribute>
   </xs:complexType>
   <xs:complexType name="RecordingComponentId">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of RecordingComponentIds.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="ProprietaryId"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:ProprietaryId">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a ProprietaryIdentifier of the RecordingComponent.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="RecordingComponentList">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of one or more RecordingComponents.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="RecordingComponent"
                     maxOccurs="unbounded"
                     type="rin:RecordingComponent">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a RecordingComponent.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
      <xs:attribute name="LanguageAndScriptCode" type="xs:string">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The Language and script for the Elements of the RecordingComponentList as defined in IETF RfC 5646. The default is the same as indicated for the containing composite. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
   </xs:complexType>
   <xs:complexType name="RecordingInformationNotification">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the DDEX Recording Information Notification standard, containing information about one or more RecordingComponents or Recordings as well as related entities such as Projects, Parties, Sessions and MusicalWorks. The RecordingComponents or Recordings described in a RecordingInformationNotification belong, typically, to the same Project.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="MessageHeader" type="rin:MessageHeader">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The MessageHeader for the RecordingInformationNotification.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Comment"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:Comment">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing a human-readable Comment about the Message.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="PartyList" minOccurs="0" type="rin:PartyList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Parties relating to the reported MusicalWorks.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="MusicalWorkList" minOccurs="0" type="rin:MusicalWorkList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more MusicalWorks.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ResourceList" minOccurs="0" type="rin:ResourceList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Resources.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-releaseresourcework-metadata/sequencing-resources</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="RecordingComponentList"
                     minOccurs="0"
                     type="rin:RecordingComponentList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more RecordingComponents.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ProjectList" minOccurs="0" type="rin:ProjectList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Projects.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="SessionList" minOccurs="0" type="rin:SessionList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Sessions.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="EquipmentList" minOccurs="0" type="rin:EquipmentList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of Equipment.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DataCarrierList" minOccurs="0" type="rin:DataCarrierList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more DataCarriers.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ElementList" minOccurs="0" type="rin:ElementList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Elements.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="FileList" minOccurs="0" type="rin:FileList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Files.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="TransferList" minOccurs="0" type="rin:TransferList">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Transfers.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ImportedRinFiles" minOccurs="0" type="rin:ImportedRinFiles">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of one or more Files incorporated into the RecordingInformationNotification.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
      <xs:attribute name="SchemaVersionId" type="xs:string" use="required">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The Identifier of the Version of the XML schema used for the File. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
      <xs:attribute name="AvsVersionId" type="xs:string" use="required">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
      <xs:attribute name="LanguageAndScriptCode" type="xs:string" use="required">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The Language and script for the Elements of the RecordingInformationNotification as defined in IETF RfC 5646. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
   </xs:complexType>
   <xs:complexType name="ResourceList">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of one or more Resources.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="SoundRecording"
                     maxOccurs="unbounded"
                     type="rin:SoundRecording">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a SoundRecording.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
      <xs:attribute name="LanguageAndScriptCode" type="xs:string">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The Language and script for the Elements of the ResourceList as defined in IETF RfC 5646. The default is the same as indicated for the containing composite. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
   </xs:complexType>
   <xs:complexType name="RightsController">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a RightsController. RightsControllers are typically described by Name, Identifier and Role(s).</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="PartyPartyReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a Party (specific to this Message). This is a LocalPartyAnchorReference starting with the letter P.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="P[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="RightsControllerRole"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="avs:RightsControllerRole">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A role that describes the Party involved in the administration of Rights.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:choice minOccurs="0">
            <xs:element name="RightShareUnknown" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Flag indicating whether the RightSharePercentage is unknown (=true) or not (=false).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RightSharePercentage" type="xs:decimal">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The share of the licensed Rights owned by the RightsController. RightShare information is given as a xs:decimal value with up to 6 digits (e.g. '12.5' represents 12.5%). If no information is given, 100% is assumed.</xs:documentation>
                  <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/general-guidance-on-messages/communication-of-percentages</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:choice>
         <xs:element name="Territory" minOccurs="0" type="rin:AllTerritoryCode">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The country of control.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ValidityPeriod" minOccurs="0" type="rin:ddex_IsoDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details about a ValidityPeriod.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/deals-and-commercial-aspects/start-dates,-end-dates,-start-datetimes-and-end-datetimes/</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="SampledSoundRecording">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a sampled SoundRecording.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="ISRC" minOccurs="0" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The ISRC (International Standard Recording Code as defined in ISO 3901) for the SoundRecording. An ISRC comprises four parts: two characters, followed by three alphanumeric characters, then two digits and five digits. DDEX will enforce the syntax [a-zA-Z]{2}[a-zA-Z0-9]{3}[0-9]{7} using XML Schema in the future.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Title"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:TitleWithUDV">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a Title of the SoundRecording.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DisplayArtistName"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:DisplayArtistName">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing the Name to be used by a DSP when presenting Artist details of the Release to a Consumer.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/communicating-displayartists-and-displayartistname</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/displayartistnames-for-releases-and-resources</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/information-on-displayartists%2C-displayartistnames%2C-contributors-and-indirectcontributors</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DisplayArtist"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:DisplayArtist">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a DisplayArtist of the SoundRecording (specific to this message).</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/communicating-displayartists-and-displayartistname</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/displayartistnames-for-releases-and-resources</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/information-on-displayartists%2C-displayartistnames%2C-contributors-and-indirectcontributors</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="StartTime" minOccurs="0" type="xs:duration">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The start time of the sample, measured from the start of the SoundRecording (using the ISO 8601 PT[[hhH]mmM]ssS format, where lower case characters indicate variables, upper case characters are part of the xs:string, e.g. one hour, two minutes and three seconds would be PT1H2M3S). The seconds section ss may include fractions (e.g. one minute and 30.5 seconds would be PT1M30.5S).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Duration" minOccurs="0" type="xs:duration">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Duration of the sampled SoundRecording (using the ISO 8601 PT[[hhH]mmM]ssS format, where lower case characters indicate variables, upper case characters are part of the xs:string, e.g. one hour, two minutes and three seconds would be PT1H2M3S). The seconds section ss may include fractions (e.g. one minute and 30.5 seconds would be PT1M30.5S).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="AdditionalInformation"
                     minOccurs="0"
                     type="rin:AdditionalInformation">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing additional information about the RIN metadata for the sample.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Session">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a Session.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="SessionId"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:SessionId">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of an Identifier of the Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="SessionReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier (specific to the File) of the Session. This is a LocalSessionAnchor starting with the letter O.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:ID">
                  <xs:pattern value="O[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="SessionType" type="avs:SessionType">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Type of Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="StartDateTime" minOccurs="0" type="xs:dateTime">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The DateTime that marks the beginning of the Session (the only allowed format is ISO 8601: YYYY-MM-DDThh:mm:ssTZD).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="EndDateTime" minOccurs="0" type="xs:dateTime">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The DateTime that marks the end of the Session (the only allowed format is ISO 8601: YYYY-MM-DDThh:mm:ssTZD).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Venue"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:Venue">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the venue where the Session took place.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="IsUnionSession" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Session is a union Session (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="IsAnalogSession" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Session is an analog Session (=true) or not (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="BitDepth" minOccurs="0" type="xs:integer">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The BitDepth of the Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="SamplingRate" minOccurs="0" type="xs:decimal">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The sample rate of the Session in kHz.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Timecode" minOccurs="0" type="rin:Timecode">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The FrameRate of the Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Comment" minOccurs="0" type="rin:Comment">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing a human-readable Comment about the Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Contributor"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:SessionContributorReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a Contributor to the Session.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="SessionProjectReference" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a Project (specific to the File). This is a LocalProjectAnchorReference starting with the letter J.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="J[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="SessionEquipmentReference"
                     minOccurs="0"
                     maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for Equipment used during the Session (specific to this Message). This is a LocalEquipmentAnchorReference starting with the letter I.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="I[\d\-_a-zA-Z]+"/>
               </xs:restriction>
