   <xs:complexType name="SessionContributorReference">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing a SessionContributorReference.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="SessionContributorReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a Contributor (specific to this Message). This is a LocalPartyAnchorReference starting with the letter P.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="P[\d\-_a-zA-Z]+"/>
