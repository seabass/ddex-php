            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a role played by the Contributor.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/one-artist-with-two-roles</xs:documentation>
            </xs:annotation>
