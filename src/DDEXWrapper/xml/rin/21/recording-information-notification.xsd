         <xs:element name="Role"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:ResourceContributorRole">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a role played by the Contributor during the Session.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/one-artist-with-two-roles</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="InstrumentType"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:InstrumentType">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of an Instrument played by the Contributor in relation to the Resource.</xs:documentation>
            </xs:annotation>
