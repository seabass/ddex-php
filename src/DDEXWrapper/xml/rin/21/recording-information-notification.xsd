   <xs:complexType name="Party">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a Party.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="PartyId" maxOccurs="unbounded" type="rin:DetailedPartyId">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the PartyId for the Party. If no Namespace is given, the Identifier is a DdexPartyId (DPID). Note that DPIDs are not normally used to identify Artists, producers or other Creators.</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors,-artists-and-writers/contributors,-artists-and-writers/</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="PartyReference">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier (specific to the Message) of the Party. This is a LocalPartyAnchor starting with the letter P.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:ID">
                  <xs:pattern value="P[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="PartyName" maxOccurs="unbounded" type="rin:DetailedPartyName">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the PartyName(s).</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers/lengths-of-artist-names</xs:documentation>
               <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-contributors%2C-artists-and-writers</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Affiliation"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:Affiliation">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of an affiliation.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="RelatedParty"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:RelatedParty">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a PartyRelatedPartyReference referring to a Party that is related to the current Party. This can be used to express, for instance, relationships between a band and its members or between a label and its parent company.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Gender" minOccurs="0" type="avs:Gender">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The gender of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="TerritoryOfResidency"
                     minOccurs="0"
                     type="rin:AllTerritoryCode">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The country of main residency of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="IsOrganization" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the Party is an Organization (=true) or a Person (=false).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="PostalAddress"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:PostalAddress">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a PostalAddress of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="PhoneNumber"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:PhoneNumber">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a PhoneNumber of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="EmailAddress"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:EmailAddress">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of an EmailAddress of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="Nationality"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="rin:CurrentTerritoryCode">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The nationality of the Party.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DateAndPlaceOfBirth" minOccurs="0" type="rin:EventDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the Date and Place of birth. This is a string with the syntax YYYY[-MM[-DD]].</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="DateAndPlaceOfDeath" minOccurs="0" type="rin:EventDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of the Date and Place of death. This is a string with the syntax YYYY[-MM[-DD]].</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PartyList">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of one or more Parties.</xs:documentation>
