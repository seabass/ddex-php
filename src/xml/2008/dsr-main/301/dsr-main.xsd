                </xs:element>
                <xs:element name="SalesReport" type="dsrm:SalesReportToRecordCompany" minOccurs="0"
                    maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>A Composite containing details of SalesTransactions by a
