   <xs:complexType name="Generator">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a generator. The Atom generator element is defined in section 4.2.4 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:simpleContent>
         <xs:extension base="xs:string">
            <xs:attribute name="uri" type="xs:anyURI">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The URI. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
            <xs:attribute name="version" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Identifier of the Version of the generator. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
            <xs:anyAttribute namespace="##other"/>
         </xs:extension>
      </xs:simpleContent>
   </xs:complexType>
