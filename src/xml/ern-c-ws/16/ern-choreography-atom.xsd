   <xs:element name="Feed">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the ERN Choreography Standard for an atom feed defined by W3C/IETF. The Atom feed construct is defined in section 4.1.1 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice minOccurs="3" maxOccurs="unbounded">
            <xs:element name="author" minOccurs="0" maxOccurs="unbounded" type="atom:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of an author of a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="category" minOccurs="0" maxOccurs="unbounded" type="atom:Category">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a category.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="contributor" minOccurs="0" maxOccurs="unbounded" type="atom:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of a contributor to a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="generator" minOccurs="0" type="atom:Generator">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a generator.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="icon" minOccurs="0" type="atom:Icon">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an icon.</xs:documentation>
