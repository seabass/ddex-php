            <xs:element name="link" minOccurs="0" maxOccurs="unbounded" type="atom:Link">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a link.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="logo" minOccurs="0" type="atom:Logo">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a logo.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="rights" minOccurs="0" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of rights.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="subtitle" minOccurs="0" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a subtitle.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="title" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a title.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="updated" type="atom:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an update.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="entry" minOccurs="0" maxOccurs="unbounded" type="atom:Entry">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an entry.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:any namespace="##other" minOccurs="0" maxOccurs="unbounded"/>
         </xs:choice>
         <xs:anyAttribute namespace="##other"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="Entry">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the ERN Choreography Standard for an atom entry defined by W3C/IETF. The Atom entry construct is defined in section 4.1.2 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice maxOccurs="unbounded">
            <xs:element name="author" minOccurs="0" maxOccurs="unbounded" type="atom:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of an author of a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="category" minOccurs="0" maxOccurs="unbounded" type="atom:Category">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a category.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="content" minOccurs="0" type="atom:Content">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a content.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="contributor" minOccurs="0" maxOccurs="unbounded" type="atom:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of a contributor to a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="id" type="atom:Id">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an ID.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="link" minOccurs="0" maxOccurs="unbounded" type="atom:Link">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a link.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="published" minOccurs="0" type="atom:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a published.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="rights" minOccurs="0" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of rights.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="source" minOccurs="0" type="atom:Source">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a source.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="summary" minOccurs="0" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a summary.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="title" type="atom:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a title.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="updated" type="atom:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an update.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ReleaseType" minOccurs="0" type="avs:ReleaseType_ERN4">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Type of Release according to its content, Duration and/or number of components. Note: a ReleaseType is the form in which a ReleaseCreator anticipates offering a Release to Consumers.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ReleaseId" minOccurs="0" type="atom:ReleaseId">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of ReleaseIds. If available, a GRid has to be used. If the Release contains only one SoundRecording, the ISRC of the SoundRecording may be used instead. If the Release is an abstraction of a complete PhysicalProduct (such as a CD Album), the ICPN of the PhysicalProduct may be used instead.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="DisplayArtistName" minOccurs="0"
               type="atom:DisplayArtistNameWithDefault">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing the Name to be used by a DSP when presenting Artist details of the Release to a Consumer.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:choice>
         <xs:anyAttribute namespace="##other"/>
      </xs:complexType>
   </xs:element>
   <xs:complexType name="Category">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a category. The Atom cagegory construct is defined in section 4.2.2 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:attribute name="term" type="xs:string" use="required">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The term. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
      </xs:attribute>
      <xs:attribute name="scheme" type="xs:anyURI">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The scheme. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
