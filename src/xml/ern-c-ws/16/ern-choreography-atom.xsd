      </xs:simpleContent>
   </xs:complexType>
   <xs:complexType name="Link" mixed="true">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a link. The Atom link construct is defined in section 3.4 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:attribute name="href" type="xs:anyURI" use="required">
         <xs:annotation>
            <xs:documentation source="ddex:Definition">The href. This is represented in an XML schema as an XML Attribute.</xs:documentation>
         </xs:annotation>
