   <xs:element name="ManifestMessage">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the Musical Works Notification and Licensing Message Suite Standard that is sent to document the FTP transfer of a batch of Messages, potentially accompanied by Resource or Release files.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="MessageHeader" type="mc-us-lic:FtpMessageHeader">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The MessageHeader for the ManifestMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="IsTestFlag" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Flag indicating whether the Message is a TestMessage (=true) or a LiveMessage (=false).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="MessageNotificationPeriod" type="mc-us-lic:MessageNotificationPeriod">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a reporting Period covered by the Messages. It must contain at least one out of StartDate or EndDate. The StartDate must be earlier than the EndDate if both are provided.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RootDirectory" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">An Identifier of the root directory of all Messages in the batch communicated through the ManifestMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="NumberOfMessages" type="xs:integer">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The number of Messages in the batch communicated through the ManifestMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="MessageInBatch" maxOccurs="unbounded" type="mc-us-lic:MessageInBatch">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a Message in the Batch.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="MessageVersionId" type="xs:string" use="required">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Version of the Message.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="BusinessProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the business profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="ReleaseProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the release profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="AvsVersionId" type="xs:string" use="optional">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
      </xs:complexType>
   </xs:element>
   <xs:element name="FtpAcknowledgementMessage">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A response Message in the Musical Works Notification and Licensing Message Suite Standard that is sent to acknowledge the receipt of a manifest File via FTP.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="MessageHeader" type="mc-us-lic:BasicFtpMessageHeader">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The MessageHeader for the Message.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="AcknowledgedMessageId" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Message Files whose receipt is acknowledged.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="FileStatus" type="mc-us-lic:FileStatus">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the File Status.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ErrorText" minOccurs="0" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Comment about the Message. This is solely to aid the MessageRecipient of the Message to resolve the issues complained about.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ProposedActionType" minOccurs="0" type="mc-us-lic:ProposedActionType">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Type of action that is proposed.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="MessageVersionId" type="xs:string" use="required">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Version of the Message.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="AvsVersionId" type="xs:string" use="optional">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
      </xs:complexType>
   </xs:element>
   <xs:element name="LicenseRequestMessage">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the US Musical Works Licensing Message Suite and Choreography Standard, which conveys information about a Request for a License for a MusicalWork or RightShare thereof. The message can also be used to convey intentions to use under an existing License (e.g. when controlled composition clauses apply or when a statutory License applies). This message has been developed specifically for the US market.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="MessageHeader" type="mc-us-lic:MessageHeader">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The MessageHeader for the LicenseRequestMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="MessagePurpose" type="avs:RequestMessagePurpose">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The purpose of the LicenseRequestMessage, which can be used to request a License or to notify the MessageRecipient of the intent to use a Work. </xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="PartyList" type="mc-us-lic:PartyList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Parties relating to the reported MusicalWorks.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="WorkList" type="mc-us-lic:WorkList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more MusicalWorks reported in this Message.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ResourceList" minOccurs="0" type="mc-us-lic:ResourceList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Resources for the reported MusicalWorks.</xs:documentation>
                  <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/guidance-on-releaseresourcework-metadata/sequencing-resources</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ReleaseList" minOccurs="0" type="mc-us-lic:ReleaseList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Releases relating to the requests.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RightShareList" type="mc-us-lic:RightShareList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of RightShares for the reported MusicalWorks.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ConditionList" type="mc-us-lic:ConditionList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a list of conditions and/or limitations for Usages.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="LicenseRequestList" type="mc-us-lic:LicenseRequestList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Requests for a License.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="BusinessProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the business profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="ReleaseProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the release profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="AvsVersionId" type="xs:string" use="optional">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="LanguageAndScriptCode" use="required">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Language and script for the Elements of this Message as defined in IETF RfC 5646. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:string">
                  <xs:pattern
                     value="[a-zA-Z]{2,3}(-[a-zA-Z]+){0,1}(-[a-zA-Z]{2}|-[0-9]{3}){0,1}(-[a-zA-Z][a-zA-Z0-9]{4}[a-zA-Z0-9]*){0,1}"
                  />
               </xs:restriction>
            </xs:simpleType>
         </xs:attribute>
      </xs:complexType>
   </xs:element>
   <xs:element name="LicenseMessage">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the US Musical Works Licensing Message Suite and Choreography Standard, which conveys information about a granted (or refused) License for a MusicalWork or RightShare thereof. The message can also be used to convey a confirmation of a received intention-to-use notification under an existing License (e.g. when controlled composition clauses apply or when a statutory License applies). This message has been developed specifically for the US market.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="MessageHeader" type="mc-us-lic:MessageHeader">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The MessageHeader for the LicenseMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="MessagePurpose" type="avs:MessagePurpose">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The purpose of the LicenseMessage, which can be used to grant a License or to acknowledge the Notification of the intent to use a Work. </xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="PartyList" type="mc-us-lic:PartyList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Parties relating to the reported MusicalWorks.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="WorkList" type="mc-us-lic:WorkList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more MusicalWorks reported in this Message.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RightShareList" type="mc-us-lic:RightShareList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of RightShares for the reported MusicalWorks.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="LicenseList" type="mc-us-lic:LicenseList">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of one or more Licenses.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="BusinessProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the business profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="ReleaseProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the release profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="AvsVersionId" type="xs:string" use="optional">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="LanguageAndScriptCode" use="required">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Language and script for the Elements of this Message as defined in IETF RfC 5646. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:string">
                  <xs:pattern
                     value="[a-zA-Z]{2,3}(-[a-zA-Z]+){0,1}(-[a-zA-Z]{2}|-[0-9]{3}){0,1}(-[a-zA-Z][a-zA-Z0-9]{4}[a-zA-Z0-9]*){0,1}"
                  />
               </xs:restriction>
            </xs:simpleType>
         </xs:attribute>
      </xs:complexType>
   </xs:element>
   <xs:element name="LicenseRevocationMessage">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the Musical Works Notification and Licensing Message Suite Standard, which conveys information about a License or Claim being invalidated.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="MessageHeader" type="mc-us-lic:MessageHeader">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The MessageHeader for the LicenseRevocationMessage.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="LicenseRevocationItem" maxOccurs="unbounded"
               type="mc-us-lic:LicenseRevocationItem">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the License or Claim that is being revoked.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="BusinessProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the business profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="ReleaseProfileVersionId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the release profile used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="AvsVersionId" type="xs:string" use="optional">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Identifier of the Version of the AllowedValueSets used for the Message. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
         </xs:attribute>
         <xs:attribute name="LanguageAndScriptCode" use="required">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Language and script for the Elements of this Message as defined in IETF RfC 5646. Language and Script are provided as lang[-script][-region][-variant]. This is represented in an XML schema as an XML Attribute.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:string">
                  <xs:pattern
                     value="[a-zA-Z]{2,3}(-[a-zA-Z]+){0,1}(-[a-zA-Z]{2}|-[0-9]{3}){0,1}(-[a-zA-Z][a-zA-Z0-9]{4}[a-zA-Z0-9]*){0,1}"
                  />
               </xs:restriction>
            </xs:simpleType>
         </xs:attribute>
      </xs:complexType>
   </xs:element>
   <xs:element name="Feed">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the US Musical Works Licensing Message Suite and Choreography Standard for an atom feed defined by W3C/IETF. The Atom feed construct is defined in section 4.1.1 of the format spec.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice minOccurs="3" maxOccurs="unbounded">
            <xs:element name="author" minOccurs="0" maxOccurs="unbounded" type="mc-us-lic:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of an author of a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="category" minOccurs="0" maxOccurs="unbounded"
               type="mc-us-lic:Category">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a category.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="contributor" minOccurs="0" maxOccurs="unbounded"
               type="mc-us-lic:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of a contributor to a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="generator" minOccurs="0" type="mc-us-lic:Generator">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a generator.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="icon" minOccurs="0" type="mc-us-lic:Icon">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an icon.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="id" type="mc-us-lic:Id">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an ID.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="link" minOccurs="0" maxOccurs="unbounded" type="mc-us-lic:Link">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a link.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="logo" minOccurs="0" type="mc-us-lic:Logo">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a logo.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="rights" minOccurs="0" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of rights.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="subtitle" minOccurs="0" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a subtitle.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="title" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a title.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="updated" type="mc-us-lic:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an update.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="entry" minOccurs="0" maxOccurs="unbounded" type="mc-us-lic:Entry">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an entry.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:any namespace="##other" minOccurs="0" maxOccurs="unbounded"/>
         </xs:choice>
         <xs:anyAttribute namespace="##other"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="Entry">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Message in the US Musical Works Licensing Message Suite and Choreography Standard for atom feeds defined by W3C/IETF.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice maxOccurs="unbounded">
            <xs:element name="author" minOccurs="0" maxOccurs="unbounded" type="mc-us-lic:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of an author of a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="category" minOccurs="0" maxOccurs="unbounded"
               type="mc-us-lic:Category">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a category.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="content" minOccurs="0" type="mc-us-lic:Content">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a content.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="contributor" minOccurs="0" maxOccurs="unbounded"
               type="mc-us-lic:Person">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of the Name, Identifier and Role(s) of a contributor to a Resource.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="id" type="mc-us-lic:Id">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an ID.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="link" minOccurs="0" maxOccurs="unbounded" type="mc-us-lic:Link">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a link.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="published" minOccurs="0" type="mc-us-lic:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a published.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="rights" minOccurs="0" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of rights.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="source" minOccurs="0" type="mc-us-lic:Source">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a source.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="summary" minOccurs="0" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a summary.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="title" type="mc-us-lic:Text">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of a title.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="updated" type="mc-us-lic:DateTime">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an update.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RequestId" type="mc-us-lic:ProprietaryId">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an Identifier of the Request to which the Notification is a reply.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="MessageType" minOccurs="0" type="avs:MessageType">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Type of Message that can be downloaded from the atom feed’s link. If this element is not present, then the Message is meant to be a message as defined in mc-notif/11.</xs:documentation>
               </xs:annotation>
