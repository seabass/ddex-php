            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing a ResourceMusicalWorkReference for a MusicalWork (specific to this Message).</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
