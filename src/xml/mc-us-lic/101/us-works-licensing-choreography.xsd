            <xs:attribute name="Namespace" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Namespace of the CarrierType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
