<?xml version="1.0" encoding="UTF-8"?>
<!-- SCOW Version v0.8.52 -->
<xs:schema xmlns:mc-us-lod="http://ddex.net/xml/mc-us-lod/10"
   xmlns:avs="http://ddex.net/xml/avs/avs" xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
   xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://ddex.net/xml/mc-us-lod/10"
   elementFormDefault="unqualified" attributeFormDefault="unqualified">
   <xs:import namespace="http://ddex.net/xml/avs/avs"
      schemaLocation="http://ddex.net/xml/avs/avs-lod.xsd"/>
   <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
      schemaLocation="http://www.w3.org/TR/2002/REC-xmldsig-core-20020212/xmldsig-core-schema.xsd"/>
   <xs:annotation>
      <xs:documentation>© 2006-2020 Digital Data Exchange, LLC (DDEX)</xs:documentation>
