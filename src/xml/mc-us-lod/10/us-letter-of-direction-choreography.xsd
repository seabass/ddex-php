         <xs:element name="CatalogResourceReference" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a Resource (specific to this Message) that is part of the catalog. This is a LocalResourceAnchorReference starting with the letter A.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="A[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="ManuscriptShare">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a MusicalWorkManuscriptShare which is related to another RightShare.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="BaseRightShare">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for the BaseRightShare (specific to this message). This is a LocalRightShareAnchorReference starting with the letter S.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="S[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:choice>
            <xs:element name="RightShareUnknown" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Flag indicating whether the RightSharePercentage is unknown (=true) or not (=false).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="RightSharePercentage" type="mc-us-lod:Percentage">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The absolute percentage of rights in the Work that are delegated. This information is given as a xs:decimal value with up to 6 digits (e.g. '12.5' represents 12.5%).</xs:documentation>
                  <xs:documentation source="ddex:Comment">Further Reading: https://kb.ddex.net/implementing-each-standard/best-practices-for-all-ddex-standards/general-guidance-on-messages/communication-of-percentages</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:choice>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="MessageInBatch">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a Message in a Batch.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="MessageType" type="avs:MessageType">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The Type of Message.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="MessageId" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">An Identifier of the Message.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="URL" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A URL of the Message.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:choice minOccurs="0">
            <xs:element name="HashSum" type="mc-us-lod:HashSum">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing a HashSum of the File and information about the algorithm with which it has been generated.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="Signature" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A digital signature in accordance with DDEX-DSIG.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:choice>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="MusicalWorkId">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a MusicalWorkId.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="ISWC" minOccurs="0" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The ISWC (International Standard Musical Work Code defined in ISO 15707) identifying the MusicalWork. An ISWC comprises three parts: the letter 'T', followed by nine digits and then one check digit. DDEX will enforce the syntax [a-zA-Z][0-9]{10} using XML Schema in the future.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="OpusNumber" minOccurs="0" type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">The MusicalWorkId identifying the MusicalWork within the catalog of its Composer (typically of classical music) as an opus number.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ComposerCatalogNumber" minOccurs="0" maxOccurs="unbounded"
            type="xs:string">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A MusicalWorkId identifying a MusicalWork within the catalog of its Composer (typically of classical music) according to a standardized numbering (e.g. 'K' numbers for Koechel's catalog of Mozart).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ProprietaryId" maxOccurs="unbounded" type="mc-us-lod:ProprietaryId">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a ProprietaryIdentifier of the MusicalWork.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="OriginalPublisherShare">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of an OriginalPublisherShare which is related to another RightShare.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="OriginalPublisherShare">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for an OriginalPublisherShare (specific to this Message). This is a LocalRightShareAnchorReference starting with the letter S.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="S[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PhysicalCarrierType">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a PhysicalCarrierType.</xs:documentation>
      </xs:annotation>
      <xs:simpleContent>
         <xs:extension base="avs:PhysicalCarrierType">
            <xs:attribute name="Namespace" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Namespace of the PhysicalCarrierType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
            <xs:attribute name="UserDefinedValue" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A UserDefined value of the PhysicalCarrierType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
         </xs:extension>
      </xs:simpleContent>
   </xs:complexType>
   <xs:complexType name="ProposedActionType">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a ProposedActionType.</xs:documentation>
      </xs:annotation>
      <xs:simpleContent>
         <xs:extension base="avs:MwnlProposedActionType">
            <xs:attribute name="Namespace" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Namespace of the ProposedActionType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
            <xs:attribute name="UserDefinedValue" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A UserDefined value of the ProposedActionType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
         </xs:extension>
      </xs:simpleContent>
   </xs:complexType>
   <xs:complexType name="Retention">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a retention date applying to one or more MusicalWorks.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="RetentionDate" type="mc-us-lod:ddex_IsoDate">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A RetentionDate applying to MusicalWorks.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="MusicalWorkId" maxOccurs="unbounded" type="mc-us-lod:MusicalWorkId">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of a MusicalWorkId of a MusicalWork for which the RetentionDate is provided.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="SupplementalDocument">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a document.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="DocumentType" minOccurs="0" type="avs:DocumentType_LoD">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Type of document sent in this Message.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:choice>
            <xs:element name="ReferencedDocumentId" type="mc-us-lod:ProprietaryId">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A Composite containing details of an Identifier of a previously sent document.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:sequence>
               <xs:element name="URL" type="xs:string">
                  <xs:annotation>
                     <xs:documentation source="ddex:Definition">A URL of the PDF File of the contract.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="DocumentId" type="mc-us-lod:ProprietaryId">
                  <xs:annotation>
                     <xs:documentation source="ddex:Definition">A Composite containing details of the Identifier of the document sent in this Message, for future reference.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:choice>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="TransferredRightShare">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of RightShares before and after a transfer of rights.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="HasRelinquishment" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the RightShare has been relinquished (=true) or not (=false). This element is complementary information that is added when a LoDMessage is forwarded.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="PreTransfer" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a RightShare (specific to this Message) that is subject to the CatalogTransfer (so this refers to an existing RightShare before the transfer). This is a LocalRightShareAnchorReference starting with the letter S.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="S[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="PostTransfer" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Reference for a RightShare (specific to this Message) that results from the CatalogTransfer (so this refers to a RightShare after the transfer). This is a LocalRightShareAnchorReference starting with the letter S.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
               <xs:restriction base="xs:IDREF">
                  <xs:pattern value="S[\d\-_a-zA-Z]+"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="TransferredRightShareList">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of one or more transferred RightShares.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="IsPartial" type="xs:boolean">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Flag indicating whether the CatalogTransfer is partial (=true) or not (=false). If this Flag is set to true, the list of RightShares is a sub-set of all the catalog's RightShares and defines the Works that are actually transferred. If this Flag is set to false, the full Catalog is transferred, even if the list of RightShares is only a sub-set of the catalog's RightShares.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="TransferredRightShare" maxOccurs="unbounded"
            type="mc-us-lod:TransferredRightShare">
            <xs:annotation>
               <xs:documentation source="ddex:Definition">A Composite containing details of RightShares before and after a transfer of rights.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="UseTypeForWorksNotificationLicensing">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Composite containing details of a UseType.</xs:documentation>
         <xs:documentation source="ddex:Comment">Explanatory Note: This Composite is named UseTypeForWorksNotificationLicensing to disambiguate it from the basic UseType Composite. The name indicates that it is MWNL specific.</xs:documentation>
      </xs:annotation>
      <xs:simpleContent>
         <xs:extension base="avs:UseType_MWNL">
            <xs:attribute name="Namespace" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">The Namespace of the UseType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
            <xs:attribute name="UserDefinedValue" type="xs:string">
               <xs:annotation>
                  <xs:documentation source="ddex:Definition">A UserDefined value of the UseType. This is represented in an XML schema as an XML Attribute.</xs:documentation>
               </xs:annotation>
            </xs:attribute>
         </xs:extension>
      </xs:simpleContent>
   </xs:complexType>
   <xs:simpleType name="ddex_LocalPartyAnchorReference">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A LocalAnchorReference which acts as a reference to a local Identifier of a Party. This LocalAnchorReference is a xs:string starting with the letter P.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:IDREF">
         <xs:pattern value="P[\d\-_a-zA-Z]+"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="ddex_LocalResourceAnchorReference">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A LocalAnchorReference which acts as a reference to a local Identifier of a Resource. This LocalAnchorReference is a xs:string starting with the letter A.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:IDREF">
         <xs:pattern value="A[\d\-_a-zA-Z]+"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="ddex_IsoDate">
      <xs:annotation>
         <xs:documentation source="ddex:Definition">A Date represented in ISO 8601 format: YYYY[-MM[-DD]].</xs:documentation>
         <xs:documentation source="ddex:Comment">Format: A Date represented as a calendar Year, Month or Day (in ISO 8601 format: YYYY, YYYY-MM or YYYY-MM-DD).</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:pattern value="[0-9]{4}(-[0-9]{2}){0,1}(-[0-9]{2}){0,1}"/>
      </xs:restriction>
   </xs:simpleType>
</xs:schema>
